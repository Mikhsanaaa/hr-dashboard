generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Employee {
  id              Int      @id @default(autoincrement())
  employeeNumber  Int      @unique
  age             Int
  gender          String
  department      String
  jobRole         String
  monthlyIncome   Int
  overTime        String
  attrition       String
  yearsAtCompany  Int
  jobSatisfaction Int
  workLifeBalance Int
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
  role     String @default("viewer")
}